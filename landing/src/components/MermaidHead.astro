---
// Starlight Head override that initialises Mermaid.js for client-side rendering.
// The rehype plugin in astro.config.mjs outputs <pre class="mermaid"> elements;
// this script picks them up and renders the diagrams in the browser.
// Mermaid loads from the CDN (pinned version) to keep it out of the npm tree.
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props}><slot /></Default>

<script is:inline type="module">
  function renderMermaid() {
    const nodes = document.querySelectorAll('pre.mermaid:not([data-processed])');
    if (nodes.length === 0) return;
    import('https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs').then(
      ({ default: mermaid }) => {
        mermaid.initialize({ startOnLoad: false });
        mermaid.run({ nodes });
      }
    );
  }

  // Initial page load
  renderMermaid();

  // Astro View Transitions: re-run after each navigation
  document.addEventListener('astro:page-load', renderMermaid);
</script>
