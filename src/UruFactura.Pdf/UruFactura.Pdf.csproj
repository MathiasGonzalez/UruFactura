<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UruFactura</RootNamespace>
    <AssemblyName>UruFactura.Pdf</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>MathiasGonzalez</Authors>
    <Description>Representación impresa de los CFE de UruFactura: PDF A4, PDF térmico (80 mm) y código QR según la normativa de la DGI.</Description>
    <PackageTags>dgi;uruguay;efactura;cfe;facturacion-electronica;pdf</PackageTags>
    <PackageId>UruFactura.Pdf</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MathiasGonzalez/UruFactura</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MathiasGonzalez/UruFactura</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UruFactura.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentReport" Version="1.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UruFactura\UruFactura.csproj" />
  </ItemGroup>

</Project>
