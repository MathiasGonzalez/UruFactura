<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UruFactura</RootNamespace>
    <AssemblyName>UruFactura</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>MathiasGonzalez</Authors>
    <Description>SDK .NET para facturación electrónica de la DGI de Uruguay (CFE): emisión, firma, numeración con CAE, envío a la DGI y reporte diario. Sin dependencias de terceros; la representación impresa está en UruFactura.Pdf.</Description>
    <PackageTags>dgi;uruguay;efactura;cfe;facturacion-electronica</PackageTags>
    <PackageId>UruFactura</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MathiasGonzalez/UruFactura</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MathiasGonzalez/UruFactura</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UruFactura.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

</Project>
