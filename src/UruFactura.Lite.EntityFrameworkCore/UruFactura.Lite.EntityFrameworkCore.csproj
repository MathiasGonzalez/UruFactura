<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UruFactura.EntityFrameworkCore</RootNamespace>
    <AssemblyName>UruFactura.Lite.EntityFrameworkCore</AssemblyName>
    <Version>1.1.0</Version>
    <Authors>MathiasGonzalez</Authors>
    <Description>Persistencia con Entity Framework Core para UruFactura.Lite: CAE con numeración atómica entre instancias y registro de CFE emitidos para el reporte diario.</Description>
    <PackageTags>dgi;uruguay;efactura;cfe;facturacion-electronica;entityframeworkcore;lite</PackageTags>
    <PackageId>UruFactura.Lite.EntityFrameworkCore</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MathiasGonzalez/UruFactura</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/MathiasGonzalez/UruFactura</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
  </ItemGroup>

  <!-- Mismas fuentes que UruFactura.EntityFrameworkCore, compiladas contra UruFactura.Lite
       (los tipos del core viven en otro assembly, por eso no sirve el paquete del SDK completo). -->
  <ItemGroup>
    <Compile Include="../UruFactura.EntityFrameworkCore/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UruFactura.Lite\UruFactura.Lite.csproj" />
  </ItemGroup>

</Project>
